{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handshake v0.1 verdict",
  "description": "Wire schema for Handshake v0.1 \"verdict\" messages (SPEC §4): envelope (by reference) plus the type payload. Provisional field shapes are marked in their descriptions.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "msg_type",
        "verdict",
        "evidence_refs",
        "dissent"
      ],
      "properties": {
        "msg_type": {
          "const": "verdict"
        },
        "verdict": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "evidence_refs": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "dissent": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "unknown": {
      "type": "object",
      "required": [
        "_unknown",
        "reason"
      ],
      "properties": {
        "_unknown": {
          "const": true
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "na": {
      "type": "object",
      "required": [
        "_na",
        "reason"
      ],
      "properties": {
        "_na": {
          "const": true
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
