{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handshake v0.1 approval-request",
  "description": "Wire schema for Handshake v0.1 \"approval-request\" messages (SPEC §4): envelope (by reference) plus the type payload. Provisional field shapes are marked in their descriptions.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "msg_type",
        "subject",
        "exact_content",
        "channel",
        "requested_by",
        "approval_status",
        "approver"
      ],
      "properties": {
        "msg_type": {
          "const": "approval-request"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "exact_content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "requested_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "approval_status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "rejected"
              ]
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "decision_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "approver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "approval_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "approval_status": {
                "const": "pending"
              }
            },
            "required": [
              "approval_status"
            ]
          },
          "then": {
            "properties": {
              "decision_ref": {
                "anyOf": [
                  {
                    "const": "pending"
                  },
                  {
                    "$ref": "#/$defs/unknown"
                  },
                  {
                    "$ref": "#/$defs/na"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "approval_status": {
                "enum": [
                  "approved",
                  "rejected"
                ]
              }
            },
            "required": [
              "approval_status"
            ]
          },
          "then": {
            "required": [
              "decision_ref"
            ],
            "properties": {
              "decision_ref": {
                "type": "string",
                "not": {
                  "const": "pending"
                }
              }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "unknown": {
      "type": "object",
      "required": [
        "_unknown",
        "reason"
      ],
      "properties": {
        "_unknown": {
          "const": true
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "na": {
      "type": "object",
      "required": [
        "_na",
        "reason"
      ],
      "properties": {
        "_na": {
          "const": true
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
