{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handshake v0.1 kill-signal",
  "description": "Wire schema for Handshake v0.1 \"kill-signal\" messages (SPEC §4): envelope (by reference) plus the type payload. Provisional field shapes are marked in their descriptions.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "msg_type",
        "initiative_id",
        "trigger",
        "issued_by",
        "authority_ref",
        "kill_rule_ref"
      ],
      "properties": {
        "msg_type": {
          "const": "kill-signal"
        },
        "initiative_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "trigger": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "metric",
                "value"
              ],
              "properties": {
                "metric": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/unknown"
                    },
                    {
                      "$ref": "#/$defs/na"
                    }
                  ]
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "$ref": "#/$defs/unknown"
                    },
                    {
                      "$ref": "#/$defs/na"
                    }
                  ]
                },
                "observed_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "$ref": "#/$defs/unknown"
                    },
                    {
                      "$ref": "#/$defs/na"
                    }
                  ]
                }
              },
              "$comment": "PROVISIONAL: SPEC §4.8 names \"measured numbers\" with no exact shape."
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "issued_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "authority_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "kill_rule_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "unknown": {
      "type": "object",
      "required": [
        "_unknown",
        "reason"
      ],
      "properties": {
        "_unknown": {
          "const": true
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "na": {
      "type": "object",
      "required": [
        "_na",
        "reason"
      ],
      "properties": {
        "_na": {
          "const": true
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
