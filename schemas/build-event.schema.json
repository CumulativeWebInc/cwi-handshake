{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handshake v0.1 build-event",
  "description": "Wire schema for Handshake v0.1 \"build-event\" messages (SPEC §4): envelope (by reference) plus the type payload. Provisional field shapes are marked in their descriptions.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "msg_type",
        "project",
        "stage",
        "artifact_ref",
        "tests",
        "checkpoint_evidence",
        "gate"
      ],
      "properties": {
        "msg_type": {
          "const": "build-event"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "stage": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "discover",
                "design",
                "build",
                "test",
                "deploy",
                "go-live",
                "post-launch"
              ]
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "artifact_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "tests": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "passed",
                "total"
              ],
              "properties": {
                "passed": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "$ref": "#/$defs/unknown"
                    },
                    {
                      "$ref": "#/$defs/na"
                    }
                  ]
                },
                "total": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "$ref": "#/$defs/unknown"
                    },
                    {
                      "$ref": "#/$defs/na"
                    }
                  ]
                }
              },
              "$comment": "passed <= total is enforced by the validators only; JSON Schema cannot express cross-field numeric comparison."
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "checkpoint_evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "gate": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "blocked"
              ]
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "unknown": {
      "type": "object",
      "required": [
        "_unknown",
        "reason"
      ],
      "properties": {
        "_unknown": {
          "const": true
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "na": {
      "type": "object",
      "required": [
        "_na",
        "reason"
      ],
      "properties": {
        "_na": {
          "const": true
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
