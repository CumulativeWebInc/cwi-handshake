{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handshake v0.1 resource-request",
  "description": "Wire schema for Handshake v0.1 \"resource-request\" messages (SPEC §4): envelope (by reference) plus the type payload. Provisional field shapes are marked in their descriptions.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "msg_type",
        "resource_ref",
        "constraints",
        "requested_by",
        "expires_at"
      ],
      "properties": {
        "msg_type": {
          "const": "resource-request"
        },
        "resource_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "constraints": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "requested_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "unknown": {
      "type": "object",
      "required": [
        "_unknown",
        "reason"
      ],
      "properties": {
        "_unknown": {
          "const": true
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "na": {
      "type": "object",
      "required": [
        "_na",
        "reason"
      ],
      "properties": {
        "_na": {
          "const": true
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
