{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handshake v0.1 result-receipt",
  "description": "Wire schema for Handshake v0.1 \"result-receipt\" messages (SPEC §4): envelope (by reference) plus the type payload. Provisional field shapes are marked in their descriptions.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "msg_type",
        "initiative_id",
        "result",
        "receipt",
        "verified_by",
        "verified_at"
      ],
      "properties": {
        "msg_type": {
          "const": "result-receipt"
        },
        "initiative_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "result": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "verified_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        },
        "verified_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "$ref": "#/$defs/unknown"
            },
            {
              "$ref": "#/$defs/na"
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "unknown": {
      "type": "object",
      "required": [
        "_unknown",
        "reason"
      ],
      "properties": {
        "_unknown": {
          "const": true
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "na": {
      "type": "object",
      "required": [
        "_na",
        "reason"
      ],
      "properties": {
        "_na": {
          "const": true
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
